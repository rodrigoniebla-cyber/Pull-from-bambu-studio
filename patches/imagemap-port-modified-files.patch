+// Image-map per-layer color rotation. Ported from OrcaSlicer-ImageMap
+// (https://github.com/sentientstardust-dev/OrcaSlicer-ImageMap, release
+// v1.0.22, commit 92548381056dbf72836b0a1bdc455f238218dbfb): the origin's
+// ToolOrdering resolves texture-mapping zone ids to a single physical
+// filament per layer via TextureMappingManager::resolve_zone_component().
+// Bambu Studio has no texture zones in Phase 1, so the rotation set is
+// derived from the painted body print regions instead and the per-layer
+// remap is stored in LayerTools::image_map_filament_resolution, mirroring
+// the existing resolve_mixed_filaments() mechanism.
+//
+// LOW-CONFIDENCE MAPPING NOTE (AMS/multi-material internals): the origin
+// resolves zones inside collect_extruders() while Bambu Studio's tool
+// ordering additionally performs multi-extruder filament grouping and
+// flush-volume reordering (H2C / dual-nozzle machines). This port therefore
+// collapses filaments *before* reorder_extruders_for_minimum_flush_volume(),
+// exactly where resolve_mixed_filaments() already does the same kind of
+// remap, so all downstream grouping (including the H2C paths in
+// reorder_extruders_for_minimum_flush_volume) sees ordinary physical
+// filaments and is otherwise untouched.
+void ToolOrdering::resolve_image_map_per_layer_filaments(const PrintConfig &config)
+{
+    m_image_map_rotation.clear();
+    // Default OFF: everything below is skipped and no LayerTools state changes.
+    if (!ImageMapPerLayer::enabled(config))
+        return;
+    if (m_print == nullptr)
+        return;
+    // Conservative: never combine with the mixed-filament (virtual slot)
+    // feature — the two per-layer remaps would interact in untested ways.
+    if (has_any_mixed_filament(config.filament_is_mixed.values))
+        return;
+
+    const std::vector<unsigned int> rotation = ImageMapPerLayer::rotation_filaments(*m_print);
+    if (rotation.size() < 2)
+        return;
+    const std::vector<unsigned int> sequence = ImageMapPerLayer::rotation_sequence(rotation);
+    if (sequence.empty())
+        return;
+
+    const std::set<unsigned int> rotation_set(rotation.begin(), rotation.end());
+    for (LayerTools &lt : m_layer_tools) {
+        const size_t layer_idx = size_t(&lt - m_layer_tools.data());
+        const unsigned int active = ImageMapPerLayer::active_filament_for_layer(sequence, int(layer_idx));
+        // Map every rotation filament on every layer so LayerTools::extruder()
+        // can never hand out a body filament that was removed from
+        // lt.extruders below (which would silently drop extrusions).
+        for (unsigned int filament : rotation)
+            lt.image_map_filament_resolution[filament] = active;
+
+        bool any_replaced = false;
+        std::vector<unsigned int> new_extruders;
+        new_extruders.reserve(lt.extruders.size());
+        for (unsigned int ext : lt.extruders) {
+            if (rotation_set.count(ext)) {
+                new_extruders.push_back(active);
+                any_replaced = true;
+            } else {
+                // Support / interface / other protected filaments keep their
+                // native tool-change path (H2C included).
+                new_extruders.push_back(ext);
+            }
+        }
+        if (any_replaced) {
+            lt.extruders = std::move(new_extruders);
+            sort_remove_duplicates(lt.extruders);
+        }
+    }
+    m_image_map_rotation = rotation;
+}
