+// ---------------------------------------------------------------------------
+// Image-map per-layer color rotation: outer-wall line-width modulation.
+// Ported from OrcaSlicer-ImageMap
+// (https://github.com/sentientstardust-dev/OrcaSlicer-ImageMap, release
+// v1.0.22, commit 92548381056dbf72836b0a1bdc455f238218dbfb), GCode.cpp outer
+// wall gradient path (ModulationLineWidth mode, lines ~11027-11360 of origin)
+// and TextureMappingOffset.cpp component_weights_for_sample().
+//
+// Phase-1 adaptation: the origin samples an image texture per path segment;
+// here the color target of a painted region is constant (the region's
+// configured filament color), so the solver weight — and therefore the
+// modulated width — is constant per path. The per-segment sampling, dithering
+// and centerline-shift machinery of the origin is Phase 2/3 scope.
+// ---------------------------------------------------------------------------
+
+void GCode::init_image_map_per_layer_color(const Print &print)
+{
+    m_image_map_modulation_enabled = false;
+    if (!ImageMapPerLayer::enabled(print.config()))
+        return; // default OFF — strict no-op
+    // Mirror the guards of ToolOrdering::resolve_image_map_per_layer_filaments()
+    // so modulation is active exactly when tool-change collapsing is.
+    const auto &is_mixed = print.config().filament_is_mixed.values;
+    if (std::any_of(is_mixed.begin(), is_mixed.end(), [](unsigned char v) { return v != 0; }))
+        return;
+    const std::vector<unsigned int> rotation = ImageMapPerLayer::rotation_filaments(print);
+    if (rotation.size() < 2)
+        return;
+    if (!m_image_map_solver.init(print.config(), rotation))
+        return;
+    m_image_map_modulation_enabled = true;
+}
+
+bool GCode::image_map_apply_outer_wall_modulation(const ExtrusionPath &path, ExtrusionPath &out)
+{
+    if (!m_image_map_modulation_enabled)
+        return false;
+    if (path.role() != erExternalPerimeter)
+        return false;
+    // A sloped path (scarf seam / spiral transitions) would lose its slope
+    // data when copied into a plain ExtrusionPath — leave it untouched.
+    if (dynamic_cast<const ExtrusionPathSloped *>(&path) != nullptr)
+        return false;
+    if (path.is_force_no_extrusion() || path.polyline.points.size() < 2)
+        return false;
+    if (m_writer.filament() == nullptr)
+        return false;
+
+    // extrude_perimeters() applies the region config into m_config before
+    // extruding, so wall_filament here is the painted region's original
+    // filament — the color target (same mechanism the origin feature used).
+    const int target_filament = m_config.wall_filament.value - 1;
+    if (target_filament < 0)
+        return false;
+    const unsigned int active_filament = m_writer.filament()->id();
+    const float weight = m_image_map_solver.weight_for(unsigned(target_filament), active_filament);
+    if (weight < 0.f)
+        return false; // active or target filament outside the rotation set
+
+    const float layer_height = path.height > EPSILON ? path.height :
+        float(m_layer != nullptr ? m_layer->height : m_last_height);
+    const float base_width = std::max(0.01f, path.width);
+    const float new_width = ImageMapPerLayer::modulated_outer_wall_width(
+        weight,
+        base_width,
+        float(m_config.texture_mapping_outer_wall_gradient_min_line_width.value),
+        float(m_config.texture_mapping_outer_wall_gradient_max_line_width.value),
+        float(m_config.texture_mapping_outer_wall_gradient_global_strength.value),
+        layer_height);
+    if (std::abs(new_width - base_width) <= 1e-4f)
+        return false;
+
+    out = path;
+    out.width = new_width;
+    out.mm3_per_mm = path.mm3_per_mm *
+        ImageMapPerLayer::flow_scale_for_width_change(base_width, new_width, layer_height);
+    return true;
+}
